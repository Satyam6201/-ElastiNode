{
  "name": "elastinode",
  "version": "1.0.0",
  "description": "ElastiNode: Auto-Scaling System with Live Load Balancer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start-all.js",
    "dev": "node scripts/start-all.js",
    "dev:dashboard": "npm run dev --workspace=@elastinode/dashboard",
    "dev:lb": "node packages/load-balancer/src/index.js",
    "dev:autoscaler": "node packages/autoscaler/src/index.js",
    "build": "npm run build --workspace=@elastinode/dashboard",
    "loadtest": "node packages/load-tester/src/run.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "supertest": "^7.3.2",
    "vitest": "^3.0.5"
  }
}
