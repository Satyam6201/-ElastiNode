{
  "name": "elastinode",
  "version": "1.0.0",
  "description": "ElastiNode: Auto-Scaling System with Live Load Balancer",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "concurrently \"node backend/src/index.js\" \"npm run dev --prefix frontend\"",
    "dev:backend": "node backend/src/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "loadtest": "node backend/src/load-tester/run.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1"
  }
}
